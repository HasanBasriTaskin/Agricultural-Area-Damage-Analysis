# ==============================================================================
# SAR + MS Tarımsal Hasar Analizi Platformu — Ortam Değişkenleri Şablonu (.env)
# ==============================================================================

# PostgreSQL / PostGIS Veritabanı
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=damage_analysis
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/damage_analysis

# Redis (Celery Broker & Cache)
REDIS_URL=redis://redis:6379/0

# MinIO S3 Uyumlu Nesne Depolama
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=damage-analysis-artifacts
MINIO_SECURE=false

# JWT Kimlik Doğrulama & Güvenlik
JWT_SECRET_KEY=tarimsal-hasar-analizi-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Earth Engine (Opsiyonel / Mock fallback mevcuttur)
# GEE_SERVICE_ACCOUNT=your-gee-sa@project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/app/credentials/gee-key.json

# Next.js & NextAuth (Frontend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tarimsal-hasar-nextauth-super-secret-key-2026
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
