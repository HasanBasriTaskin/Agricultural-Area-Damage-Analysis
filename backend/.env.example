# ==============================================================================
# Backend Ortam Değişkenleri Şablonu (.env)
# Lokal (Docker dışı) geliştirme yaparken backend/.env olarak kopyalayınız.
# ==============================================================================

# Veritabanı & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/damage_analysis
REDIS_URL=redis://localhost:6379/0

# MinIO S3 Nesne Depolama
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=damage-analysis-artifacts
MINIO_SECURE=false

# Güvenlik & JWT
JWT_SECRET_KEY=tarimsal-hasar-analizi-super-secret-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Earth Engine (Opsiyonel / Mock fallback mevcuttur)
# GEE_SERVICE_ACCOUNT_EMAIL=gee-analyst@proje.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=secrets/gee-service-account.json
